# --- Dart / Flutter ---
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
# Libraries don't commit their lockfile (https://dart.dev/go/pubspec-lock)
pubspec.lock
coverage/

# Generated API reference (dart doc)
doc/api/

# --- IDEs / editors ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Example app ---
example/.dart_tool/
example/build/
# Platform build output (example/ios and example/android also carry
# the .gitignore files generated by `flutter create`)
example/ios/Pods/
example/ios/Flutter/ephemeral/
example/android/.gradle/
example/android/local.properties
example/android/app/.cxx/

# --- Secrets: never commit ---
# Local credentials for the example app (template: vaani_defines.json.example)
example/vaani_defines.json
*.env
.env*
!.env.example
*.keystore
*.jks
key.properties
